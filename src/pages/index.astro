---
const updateFiles = import.meta.glob('../../dev/updates/*.json', { eager: true, import: 'default' });
const updates = Object.entries(updateFiles)
  .map(([path, update]) => ({ ...update, fileDate: path.match(/(\d{4}-\d{2}-\d{2})\.json$/)?.[1] }))
  .filter((update) => update.fileDate)
  .sort((a, b) => b.fileDate.localeCompare(a.fileDate))
  .map((update) => ({
    ...update,
    date: new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' }).format(new Date(`${update.fileDate}T00:00:00`)),
    long: `${update.title} ${update.text}`.length > 190,
  }));
---
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Easy FreeDge — making everyday work feel lighter." /><title>Easy FreeDge — Make room for better work</title></head><body>
<div class="announcement"><span>✦</span><span>Introducing Easy FreeDge — a smarter way to manage the household.</span></div>
<header><a class="brand" href="#idea"><b>E</b> Easy FreeDge</a><nav aria-label="Main navigation"><a class="active" href="#idea">Idea</a><a href="#progress">Progress</a></nav></header>
<main><section class="hero" id="idea"><div class="eyebrow">● &nbsp; AN OPEN PROJECT IN PROGRESS</div><h1>Less household<br /><em>busywork.</em></h1><p>Know what is at home, what is running low, and what to buy next.</p><div class="hero-actions"><a class="primary" href="#goals">Explore the idea <span>↘</span></a></div></section>
<section class="idea" id="goals"><div><label>The idea</label><h2>Stay ahead of<br /><span>everyday needs.</span></h2></div><div class="goals"><article><i class="blue">▣</i><h3>Know what’s home</h3><p>Keep a lightweight view of household products, quantities, and expiration dates.</p></article><article><i class="lime">✦</i><h3>Shop with less effort</h3><p>Turn real consumption and purchase habits into timely, useful shopping suggestions.</p></article></div></section>
<section class="progress" id="progress"><div class="heading"><div><label>The progress</label><h2>Notes from the<br /><span>workbench.</span></h2></div><p>A running record of what we are learning, making, and reconsidering.</p></div><div class="updates">{updates.map((u) => <article class:list={{ long: u.long }}><i class={u.color}></i><small>{u.tag}<time datetime={u.fileDate}>{u.date}</time></small><h3>{u.title}</h3><p>{u.text}</p></article>)}</div></section></main>
<footer><a class="brand" href="#idea"><b>E</b> Easy FreeDge</a><span>Less time managing. More time living.</span></footer>
</body></html>
