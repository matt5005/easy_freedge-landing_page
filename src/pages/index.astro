.idea{background:#ffd39a}.lime{background:#ffad4f}.goals{grid-template-columns:repeat(2,minmax(0,1fr))}.updates{grid-template-columns:repeat(2,minmax(0,1fr))}.updates article.long{grid-column:1 / -1;min-height:0}@media(max-width:800px){.goals{grid-template-columns:1fr}.updates article.long{grid-column:auto}}
